.package {
    type 0 : integer
    session 1 : integer
}

#loginserver start =====
exchange 1 {
    request {
        cpub 0 : string
    }
    response {
        code 0 : integer
        spub 1 : string
    }
}

select_gameserver 2 {
    request {
        arr 0 : *string
        token 1 : string
        serverid 2 : integer
    }
    response {
        code 0 : integer
    }
}
#loginserver end ======

